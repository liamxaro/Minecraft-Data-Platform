    WHERE has_discovery_signal = TRUE
        OR has_activity_signal = TRUE
),


support_units AS (
    SELECT
        *,

        LEAST(
            1.0,
            GREATEST(
                COALESCE(
                    discovery_score,
                    0
                )
                - 50,
                0
            )
            / NULLIF(
                100.0
                - 50,
                0
            )
        ) AS discovery_support_unit,

        LEAST(
            1.0,
            GREATEST(
                COALESCE(
                    audience_score,
                    0
                )
                - 50,
                0
            )
            / NULLIF(
                100.0
                - 50,
                0
            )
        ) AS audience_support_unit,

        LEAST(
            1.0,
            GREATEST(
                COALESCE(
                    development_activity_score,
                    0
                )
                - 50,
                0
            )
            / NULLIF(
                100.0
                - 50,
                0
            )
        ) AS activity_support_unit,

