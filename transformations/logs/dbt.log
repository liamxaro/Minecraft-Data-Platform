    create  table
      "api_modrinth_com"."main"."modrinth_project_content_signals__dbt_tmp"
  
    
    as (
      


WITH combined_signals AS (
    SELECT
        s.project_id,
        s.project_type,
        s.title,

        s.current_observed_at,

        s.current_downloads,
        s.current_downloads_gained,

        s.current_velocity,
        s.baseline_velocity,
        s.velocity_ratio,

        s.trend_score,
        s.trend_rank,
        s.is_trending_candidate,

        b.breakout_score,
        b.breakout_rank,
        b.recent_growth_share,
        b.is_breakout_candidate,

        f.fan_affinity_score,
        f.fan_affinity_rank,
        f.follows,
        f.follows_per_1000_downloads,
        f.is_fan_signal_candidate,

        a.activity_score,
        a.activity_rank,
        a.latest_version_number,
        a.latest_version_type,
        a.latest_release_at,
        a.days_since_latest_release,
        a.active_release_days_last_30_days,
        a.active_release_days_last_90_days,
        a.is_activity_candidate

    FROM "api_modrinth_com"."main"."modrinth_project_signals" AS s

    LEFT JOIN "api_modrinth_com"."main"."modrinth_project_breakout_signals" AS b
        ON s.project_id = b.project_id
        AND s.project_type = b.project_type

    LEFT JOIN "api_modrinth_com"."main"."modrinth_project_fan_signals" AS f
        ON s.project_id = f.project_id
        AND s.project_type = f.project_type

    LEFT JOIN "api_modrinth_com"."main"."modrinth_project_activity_signals" AS a
        ON s.project_id = a.project_id
        AND s.project_type = a.project_type
),


signal_families AS (
    SELECT
        *,

        GREATEST(
            COALESCE(
                trend_score,
                0
            ),
            COALESCE(
                breakout_score,
                0
            )
        ) AS discovery_score,

        fan_affinity_score
            AS audience_score,

        activity_score
            AS development_activity_score,

        CASE
            WHEN trend_score IS NOT NULL
                OR breakout_score IS NOT NULL
                THEN TRUE
            ELSE FALSE
        END AS has_discovery_signal,

        CASE
            WHEN fan_affinity_score IS NOT NULL
                THEN TRUE
            ELSE FALSE
        END AS has_audience_signal,

        CASE
            WHEN activity_score IS NOT NULL
                THEN TRUE
            ELSE FALSE
        END AS has_activity_signal

    FROM combined_signals
),


signal_counts AS (
    SELECT
        *,

        CAST(
            has_discovery_signal
            AS INTEGER
        )
        +
        CAST(
            has_audience_signal
            AS INTEGER
        )
        +
        CAST(
            has_activity_signal
            AS INTEGER
        ) AS cross_signal_count

    FROM signal_families
),


content_candidates AS (
    SELECT
        *,

        GREATEST(
            COALESCE(
                discovery_score,
                0
            ),
            COALESCE(
                audience_score,
                0
            ),
            COALESCE(
                development_activity_score,
                0
            )
        ) AS primary_signal_score

    FROM signal_counts

    WHERE has_discovery_signal = TRUE
        OR has_audience_signal = TRUE
        OR has_activity_signal = TRUE
),


raw_content_scores AS (
    SELECT
        *,

        primary_signal_score
        +
        (
            0.05
            * (
                COALESCE(
                    discovery_score,
                    0
                )
                +
                COALESCE(
                    audience_score,
                    0
                )
                +
                COALESCE(
                    development_activity_score,
                    0
                )
                -
                primary_signal_score
            )
        ) AS content_opportunity_raw_score

    FROM content_candidates
),


content_ranks AS (
    SELECT
        *,

        RANK() OVER (
            ORDER BY
                content_opportunity_raw_score
        ) AS content_score_rank,

        COUNT(*) OVER (
            PARTITION BY
                content_opportunity_raw_score
        ) AS content_score_tie_count,

        COUNT(*) OVER ()
            AS candidate_count

    FROM raw_content_scores
),


content_percentiles AS (
    SELECT
        *,

        100.0
        * (
            content_score_rank
            + (
                content_score_tie_count - 1
            ) / 2.0
        )
        / candidate_count
            AS content_opportunity_score

    FROM content_ranks
),


ranked_content AS (
    SELECT
        *,

        ROW_NUMBER() OVER (
            ORDER BY
                content_opportunity_raw_score DESC,
                cross_signal_count DESC,
                primary_signal_score DESC,
                current_downloads_gained DESC,
                project_id
        ) AS content_opportunity_rank

    FROM content_percentiles
)


SELECT
    project_id,
    project_type,
    title,

    current_observed_at,

    current_downloads,
    current_downloads_gained,

    current_velocity,
    baseline_velocity,
    velocity_ratio,

    trend_score,
    trend_rank,

    breakout_score,
    breakout_rank,
    recent_growth_share,

    fan_affinity_score,
    fan_affinity_rank,
    follows,
    follows_per_1000_downloads,

    activity_score,
    activity_rank,

    latest_version_number,
    latest_version_type,
    latest_release_at,
    days_since_latest_release,

    active_release_days_last_30_days,
    active_release_days_last_90_days,

    discovery_score,
    audience_score,
    development_activity_score,

    has_discovery_signal,
    has_audience_signal,
    has_activity_signal,

    cross_signal_count,

    primary_signal_score,

    content_opportunity_raw_score,
    content_opportunity_score,
    content_opportunity_rank,

    is_breakout_candidate

FROM ranked_content
    );
    
  
