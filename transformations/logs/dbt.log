[0m02:47:19.588350 [debug] [Thread-1 (]: On model.minecraft_data_platform.modrinth_project_versions: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "minecraft_data_platform", "target_name": "dev", "node_id": "model.minecraft_data_platform.modrinth_project_versions"} */

  
  create view "api_modrinth_com"."main"."modrinth_project_versions__dbt_tmp" as (
    WITH




successful_runs AS (
    SELECT DISTINCT
        run_id,
        project_type

    FROM bronze.main.ingestion_log

    WHERE status = 'success'
),


candidate_snapshot_keys AS MATERIALIZED (
    SELECT
        r.run_id,
        r.project_type,
        r.project_id,
        r.c_pull_timestamp_utc

    FROM bronze.main.modrinth_project_versions AS r

    INNER JOIN successful_runs AS s
        ON r.run_id = s.run_id
        AND r.project_type = s.project_type

    

    WHERE 1 = 1

    
),


latest_timestamps AS (
    SELECT
        project_type,
        project_id,
        MAX(c_pull_timestamp_utc) AS c_pull_timestamp_utc

    FROM candidate_snapshot_keys

    GROUP BY
        project_type,
        project_id
),


latest_run_ids AS (
    SELECT
        c.project_type,
        c.project_id,
        c.c_pull_timestamp_utc,
        MAX(c.run_id) AS run_id

    FROM candidate_snapshot_keys AS c

    INNER JOIN latest_timestamps AS t
        ON c.project_type = t.project_type
        AND c.project_id = t.project_id
        AND c.c_pull_timestamp_utc = t.c_pull_timestamp_utc

    GROUP BY
        c.project_type,
        c.project_id,
        c.c_pull_timestamp_utc
),


latest_project_snapshots AS (
    SELECT
        r.run_id,
        r.project_type,
        r.project_id,
        r.payload,
        r.c_pull_timestamp_utc

    FROM bronze.main.modrinth_project_versions AS r

    INNER JOIN latest_run_ids AS k
        ON r.run_id = k.run_id
        AND r.project_type = k.project_type
        AND r.project_id = k.project_id
        AND r.c_pull_timestamp_utc = k.c_pull_timestamp_utc
),


exploded_versions AS (
    SELECT
        r.run_id,
        r.project_type,
        r.project_id,
        r.c_pull_timestamp_utc,
        version_json.value AS version_payload

    FROM latest_project_snapshots AS r

    CROSS JOIN json_each(
        r.payload
    ) AS version_json
)


SELECT
    run_id,
    project_type,
    project_id,

    json_extract_string(
        version_payload,
        '$.id'
    ) AS version_id,

    sha256(
        CAST(version_payload AS VARCHAR)
    ) AS hashed_payload,

    c_pull_timestamp_utc,

    json_extract_string(
        version_payload,
        '$.author_id'
    ) AS author_id,

    json_extract_string(
        version_payload,
        '$.name'
    ) AS name,

    json_extract_string(
        version_payload,
        '$.version_number'
    ) AS version_number,

    json_extract_string(
        version_payload,
        '$.changelog'
    ) AS changelog,

    json_extract_string(
        version_payload,
        '$.changelog_url'
    ) AS changelog_url,

    CAST(
        json_extract(
            version_payload,
            '$.dependencies'
        ) AS JSON
    ) AS dependencies,

    CAST(
        json_extract(
            version_payload,
            '$.game_versions'
        ) AS VARCHAR[]
    ) AS game_versions,

    json_extract_string(
        version_payload,
        '$.version_type'
    ) AS version_type,

    CAST(
        json_extract(
            version_payload,
            '$.loaders'
        ) AS VARCHAR[]
    ) AS loaders,

    CAST(
        json_extract_string(
            version_payload,
            '$.featured'
        ) AS BOOLEAN
    ) AS featured,

    json_extract_string(
        version_payload,
        '$.status'
    ) AS status,

    json_extract_string(
        version_payload,
        '$.requested_status'
    ) AS requested_status,

    CAST(
        json_extract_string(
            version_payload,
            '$.date_published'
        ) AS TIMESTAMPTZ
    ) AS date_published,

    CAST(
        json_extract_string(
            version_payload,
            '$.downloads'
        ) AS BIGINT
    ) AS downloads,

    json_extract_string(
        version_payload,
        '$.environment'
    ) AS environment,

    CAST(
        json_extract(
            version_payload,
            '$.files'
        ) AS JSON
    ) AS files

FROM exploded_versions

WHERE json_extract_string(
    version_payload,
    '$.id'
) IS NOT NULL
  );

