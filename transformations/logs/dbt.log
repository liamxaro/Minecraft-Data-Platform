    has_activity_signal,

    has_strong_discovery_signal,
    has_strong_audience_signal,
    has_strong_activity_signal,

    cross_signal_count,

    primary_signal_score,
    support_strength,

    content_opportunity_score,
    content_opportunity_rank,

    is_breakout_candidate

FROM ranked_content
    );
    
  
